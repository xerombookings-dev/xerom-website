---
interface Props { liveEnabled?: boolean; businessDate?: string }
const { liveEnabled = false, businessDate = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Kuala_Lumpur", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date()) } = Astro.props;
const agendaDate = new Intl.DateTimeFormat("en-MY", { timeZone: "Asia/Kuala_Lumpur", weekday: "long", day: "numeric", month: "long", year: "numeric" }).format(new Date(`${businessDate}T12:00:00+08:00`));
---
<section class="rc-panel rc-agenda-panel" aria-labelledby="agenda-title" data-rc-live-enabled={liveEnabled ? 'true' : 'false'}>
  <div class="rc-panel-head"><div><h2 id="agenda-title">{agendaDate}</h2><span data-rc-agenda-subtitle>{liveEnabled ? 'MYT · shared Calendar' : 'MYT · Calendar not connected'}</span></div>{liveEnabled && <div class="rc-legend"><span class="confirmed">Confirmed</span><span class="blocked">Blocked</span><span class="open">Open</span></div>}</div>
  {liveEnabled && <p class="rc-mobile-cue">Agenda view · swipe to inspect the full operating window</p>}
  <div class="rc-empty" data-rc-connection-required hidden={liveEnabled}>
    <h2>Calendar connection required</h2>
    <p>Connect the shared Calendar to view the live schedule and bookings.</p>
    <a class="rc-button" href="/race-control/connection">View Calendar connection</a>
  </div>
  <p class="rc-panel-foot" hidden={!liveEnabled}>Loading shared Calendar schedule…</p>
  <div class="rc-live-events" data-rc-live-events aria-hidden={!liveEnabled} hidden={!liveEnabled} aria-live="polite" aria-busy={liveEnabled}>
    <p class="rc-live-status" data-rc-live-status>Loading shared Calendar schedule…</p>
    <div class="rc-live-chart-wrap"><div class="rc-live-chart" data-rc-live-chart role="grid" aria-label="Live Google Calendar resource schedule"></div></div>
    <div class="rc-live-mobile-list" data-rc-live-mobile-list aria-label="Live Google Calendar agenda"></div>
  </div>
</section>

<script>
  import { assignTimelineLanes, orderScheduleResources } from "@/lib/race-control/timeline";

  type BookingDetails = { customerName: string; customerPhone: string; customerEmail?: string; durationMinutes: number; includedControllers: number; additionalControllers: number; totalControllers: number; priceTotal: number | null; createdAt: string | null };
  type LiveEvent = { id: string; summary: string; start: string; end: string; privateProperties: Record<string,string>; bookingDetails: BookingDetails; resourceId: string; resourceName: string; serviceId: string };
  type LiveResource = { resourceId: string; serviceId: string; displayName: string; events: Array<{ id: string; summary: string; start: string; end: string; privateProperties: Record<string,string>; bookingDetails: BookingDetails; resourceId?: string; serviceId?: string }> };
  type ScheduleWindow = { start: string; end: string };
  const liveContainer = document.querySelector<HTMLElement>("[data-rc-live-events]");
  const liveStatus = document.querySelector<HTMLElement>("[data-rc-live-status]");
  const liveChart = document.querySelector<HTMLElement>("[data-rc-live-chart]");
  const liveMobileList = document.querySelector<HTMLElement>("[data-rc-live-mobile-list]");
  const footer = document.querySelector<HTMLElement>(".rc-agenda-panel .rc-panel-foot");
  const heading = document.querySelector<HTMLElement>("#agenda-title");
  const subtitle = document.querySelector<HTMLElement>("[data-rc-agenda-subtitle]");
  const dateInput = document.querySelector<HTMLInputElement>("[data-rc-business-date]");
  const previousButton = document.querySelector<HTMLButtonElement>("[data-rc-date-nav='previous']");
  const todayButton = document.querySelector<HTMLButtonElement>("[data-rc-date-nav='today']");
  const nextButton = document.querySelector<HTMLButtonElement>("[data-rc-date-nav='next']");
  const serviceFilter = document.querySelector<HTMLElement>("[data-rc-service-filter]");
  const searchInput = document.querySelector<HTMLInputElement>("[data-rc-schedule-search]");
  const liveEnabled = document.querySelector<HTMLElement>("[data-rc-live-enabled]")?.dataset.rcLiveEnabled === "true";
  const serviceNames: Record<string,string> = { "regular-sim": "sim racing", "pro-sim": "pro sim", ps5: "play lounge", control: "venue control" };
  const formatTime = (value: string) => new Intl.DateTimeFormat("en-MY", { timeZone: "Asia/Kuala_Lumpur", hour: "numeric", minute: "2-digit" }).format(new Date(value));
  const formatBusinessDate = (value: string) => new Intl.DateTimeFormat("en-MY", { timeZone: "Asia/Kuala_Lumpur", weekday: "long", day: "numeric", month: "long", year: "numeric" }).format(new Date(`${value}T12:00:00+08:00`));
  const shiftDate = (value: string, days: number) => {
    const [year, month, day] = value.split("-").map(Number);
    return new Date(Date.UTC(year, month - 1, day + days)).toISOString().slice(0, 10);
  };
  const setDateLabel = () => {
    if (dateInput?.value && heading) heading.textContent = formatBusinessDate(dateInput.value);
  };
  const dispatchSelection = (event: LiveEvent) => window.dispatchEvent(new CustomEvent("race-control:select-event", { detail: {
    bookingId: event.privateProperties?.bookingId ?? null,
    version: Number(event.privateProperties?.groupVersion ?? "0"),
    status: event.privateProperties?.status ?? "busy",
    summary: event.summary || "Calendar block",
    resourceName: event.resourceName,
    start: event.start,
     end: event.end,
     serviceId: event.serviceId,
     bookingDetails: event.bookingDetails,
     blockType: event.privateProperties?.blockType ?? null,
     blockResourceId: event.privateProperties?.resourceId ?? event.resourceId ?? null,
     blockId: event.privateProperties?.blockId ?? null,
   } }));
  const buildAxisTicks = (window: ScheduleWindow) => {
    const start = Date.parse(window.start);
    const end = Date.parse(window.end);
    const ticks: string[] = [];
    for (let cursor = start; Number.isFinite(cursor) && cursor < end; cursor += 60 * 60_000) ticks.push(new Date(cursor).toISOString());
    return ticks;
  };
  let requestSequence = 0;
  let refreshInFlight = false;
  let refreshQueued = false;
  let pollTimer: number | undefined;
  let loadedEvents: LiveEvent[] = [];
  let loadedResources: LiveResource[] = [];
  let loadedWindow: ScheduleWindow | null = null;
  const matchesFilters = (event: LiveEvent) => {
    const service = (serviceFilter as (HTMLElement & { value: string }) | null)?.value ?? "all";
    const needle = searchInput?.value.trim().toLowerCase() ?? "";
    const serviceMatch = service === "all" || event.serviceId === service;
    const searchMatch = !needle || `${event.summary} ${event.resourceName} ${event.privateProperties?.status ?? "busy"} ${event.privateProperties?.bookingId ?? ""}`.toLowerCase().includes(needle);
    return serviceMatch && searchMatch;
  };
  const renderMobileEvents = (events: LiveEvent[]) => {
    if (!liveMobileList) return;
    liveMobileList.replaceChildren();
    if (events.length === 0) return;
    for (const event of events) {
      const article = document.createElement("article");
      const time = document.createElement("time"); time.textContent = `${formatTime(event.start)}–${formatTime(event.end)}`;
      const details = document.createElement("button"); details.type = "button"; details.className = "rc-live-event-select";
      details.setAttribute("aria-label", `Details for ${event.summary || "Calendar block"}, ${event.resourceName}, ${formatTime(event.start)}–${formatTime(event.end)}`);
      const title = document.createElement("strong"); title.textContent = event.summary || "Calendar block";
      const resource = document.createElement("span"); resource.textContent = event.resourceName;
      details.appendChild(title); details.appendChild(resource); details.addEventListener("click", () => dispatchSelection(event));
      const status = document.createElement("span"); status.className = "rc-status"; status.textContent = event.privateProperties?.status ?? "Busy";
      article.appendChild(time); article.appendChild(details); article.appendChild(status); liveMobileList.appendChild(article);
    }
  };
  const renderLiveChart = (events: LiveEvent[]) => {
    if (!liveChart || !loadedWindow) return;
    const ticks = buildAxisTicks(loadedWindow);
    const axisColumns = Math.max(1, ticks.length);
    liveChart.replaceChildren();
    liveChart.style.setProperty("--rc-live-columns", String(axisColumns));
    const axis = document.createElement("div"); axis.className = "rc-live-time-row"; axis.setAttribute("role", "row"); axis.style.gridTemplateColumns = `7.8rem repeat(${axisColumns}, minmax(4rem, 1fr))`;
    const axisLabel = document.createElement("span"); axisLabel.textContent = "Resource"; axisLabel.setAttribute("role", "columnheader"); axis.appendChild(axisLabel);
    for (const tick of ticks) { const label = document.createElement("span"); label.textContent = formatTime(tick); label.setAttribute("role", "columnheader"); axis.appendChild(label); }
    liveChart.appendChild(axis);
    const startMs = Date.parse(loadedWindow.start); const endMs = Date.parse(loadedWindow.end); const span = endMs - startMs;
    for (const resource of loadedResources) {
      const resourceEvents = events.filter((event) => event.resourceId === resource.resourceId);
      const { items: lanes, laneCount } = assignTimelineLanes(resourceEvents);
      const row = document.createElement("div"); row.className = "rc-live-resource-row"; row.setAttribute("role", "row"); row.setAttribute("aria-label", `${resource.displayName} live schedule`); row.style.minHeight = `${Math.max(1, laneCount) * 3.6}rem`;
      const label = document.createElement("div"); label.className = "rc-live-resource-label"; label.setAttribute("role", "rowheader");
      const led = document.createElement("i"); led.className = resourceEvents.length > 0 ? resource.serviceId === "control" || resourceEvents.some((event) => event.privateProperties?.blockType) ? "warning" : "busy" : "";
      const labelText = document.createElement("span"); labelText.textContent = resource.displayName; const labelSub = document.createElement("small"); labelSub.textContent = serviceNames[resource.serviceId] ?? resource.serviceId; labelText.appendChild(labelSub); label.appendChild(led); label.appendChild(labelText);
      const track = document.createElement("div"); track.className = "rc-live-track"; track.setAttribute("role", "gridcell"); track.style.backgroundSize = `${100 / axisColumns}% 100%`;
      for (const { event, lane } of lanes) {
        const eventStart = Math.max(startMs, Date.parse(event.start)); const eventEnd = Math.min(endMs, Date.parse(event.end));
        if (!Number.isFinite(eventStart) || !Number.isFinite(eventEnd) || eventEnd <= eventStart) continue;
        const booking = document.createElement("button"); booking.type = "button"; booking.className = `rc-live-booking${resource.serviceId === "control" || event.privateProperties?.blockType ? " rc-live-block" : ""}`;
        booking.style.left = `${((eventStart - startMs) / span) * 100}%`; booking.style.width = `${((eventEnd - eventStart) / span) * 100}%`; booking.style.top = `${0.35 + lane * 3.6}rem`; booking.style.height = "3rem";
        booking.setAttribute("aria-label", `Details for ${event.summary || "Calendar block"}, ${resource.displayName}, ${formatTime(event.start)}–${formatTime(event.end)}`);
        const title = document.createElement("strong"); title.textContent = event.summary || "Calendar block"; const time = document.createElement("span"); time.textContent = `${formatTime(event.start)}–${formatTime(event.end)}`; booking.appendChild(title); booking.appendChild(time); booking.addEventListener("click", () => dispatchSelection(event)); track.appendChild(booking);
      }
      row.appendChild(label); row.appendChild(track); liveChart.appendChild(row);
    }
  };
  const renderLiveEvents = () => {
    const events = loadedEvents.filter(matchesFilters);
    if (liveStatus) { liveStatus.hidden = events.length > 0; liveStatus.textContent = loadedEvents.length === 0 ? "No busy Calendar events for this business date." : "No matching Calendar events."; }
    renderLiveChart(events);
    renderMobileEvents(events);
  };
  async function refreshSchedule() {
    if (!liveContainer || !dateInput || !liveEnabled) return;
    if (refreshInFlight) { refreshQueued = true; return; }
    refreshInFlight = true;
    const requestId = ++requestSequence;
    const requestedBusinessDate = dateInput.value;
    setDateLabel();
    window.dispatchEvent(new CustomEvent("race-control:selection-clear"));
    liveContainer.hidden = false; liveContainer.setAttribute("aria-hidden", "false"); liveContainer.setAttribute("aria-busy", "true");
    try {
      const response = await fetch(`/api/admin/schedule?businessDate=${encodeURIComponent(requestedBusinessDate)}`, { cache: "no-store" });
      const payload = await response.json() as { serverNow: string; error?: { message?: string }; data: { businessWindow: ScheduleWindow; resources: LiveResource[] } };
      if (!response.ok) throw new Error(payload.error?.message ?? "Schedule unavailable.");
      if (requestId !== requestSequence || requestedBusinessDate !== dateInput.value) { refreshQueued = true; return; }
      loadedResources = orderScheduleResources(payload.data.resources);
      loadedWindow = payload.data.businessWindow;
      loadedEvents = loadedResources.flatMap((resource) => resource.events.map((event) => ({ ...event, resourceId: event.resourceId ?? resource.resourceId, resourceName: resource.displayName, serviceId: event.serviceId ?? resource.serviceId }))).sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
      renderLiveEvents();
      liveContainer.classList.remove("rc-schedule-stale");
      if (subtitle) subtitle.textContent = "MYT · shared Calendar";
      if (footer) footer.textContent = `Live Calendar read · refreshed ${new Intl.DateTimeFormat("en-MY", { timeZone: "Asia/Kuala_Lumpur", hour: "numeric", minute: "2-digit", second: "2-digit" }).format(new Date(payload.serverNow))}`;
    } catch (error) {
      if (requestId !== requestSequence || requestedBusinessDate !== dateInput.value) { refreshQueued = true; return; }
      const staleContextAvailable = loadedResources.length > 0 && loadedWindow !== null;
      if (staleContextAvailable) {
        renderLiveEvents();
        liveContainer.classList.add("rc-schedule-stale");
        if (liveStatus) { liveStatus.hidden = false; liveStatus.textContent = "Live Calendar unavailable. Showing the last successful schedule as stale context; no availability is being claimed."; }
      } else {
        loadedResources = []; loadedEvents = []; loadedWindow = null;
        liveChart?.replaceChildren(); liveMobileList?.replaceChildren();
        if (liveStatus) { liveStatus.hidden = false; liveStatus.textContent = error instanceof Error ? `${error.message} No availability is being claimed.` : "Schedule unavailable. No availability is being claimed."; }
      }
      if (subtitle) subtitle.textContent = "MYT · live read unavailable";
      if (footer) footer.textContent = "Live Calendar read unavailable · retry or reconnect Google.";
    } finally {
      refreshInFlight = false;
      if (requestId === requestSequence) liveContainer.setAttribute("aria-busy", "false");
      if (refreshQueued && document.visibilityState === "visible") { refreshQueued = false; void refreshSchedule(); }
    }
  }
  const setDate = (value: string) => { if (!dateInput || !value) return; dateInput.value = value; setDateLabel(); if (liveEnabled) refreshSchedule(); };
  previousButton?.addEventListener("click", () => dateInput?.value && setDate(shiftDate(dateInput.value, -1)));
  todayButton?.addEventListener("click", () => setDate(dateInput?.dataset.rcToday ?? dateInput?.value ?? ""));
  nextButton?.addEventListener("click", () => dateInput?.value && setDate(shiftDate(dateInput.value, 1)));
  serviceFilter?.addEventListener("change", renderLiveEvents);
  searchInput?.addEventListener("input", renderLiveEvents);
  dateInput?.addEventListener("change", refreshSchedule);
  window.addEventListener("race-control:refresh", refreshSchedule);
  const stopPolling = () => {
    if (pollTimer !== undefined) { window.clearInterval(pollTimer); pollTimer = undefined; }
  };
  const startPolling = () => {
    if (!liveEnabled || document.visibilityState !== "visible" || pollTimer !== undefined) return;
    pollTimer = window.setInterval(() => { void refreshSchedule(); }, 60_000);
  };
  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") { void refreshSchedule(); startPolling(); } else stopPolling();
  });
  window.addEventListener("focus", () => { if (document.visibilityState === "visible") void refreshSchedule(); });
  window.addEventListener("beforeunload", stopPolling);
  if (liveEnabled) { void refreshSchedule(); startPolling(); }
</script>
